# Battle.net API-klient: skapa på https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=eu
BLIZZARD_LOCALE=en_GB

# Hus att samla in: id (rekommenderas) eller del av namn, kommaseparerat.
# Loggen listar alla hus vid start: 'Tillgängliga hus: 113=..., 114=...'
AH_HOUSES=horde
AH_DEFAULT_HOUSE=horde
# Lämna tomt för att välja första ruleset automatiskt (alla delar samma hus)
AH_RULESET_ID=

AH_DB_PATH=/data/ah.sqlite
AH_POLL_MINUTES=20
AH_HOURLY_RETENTION_DAYS=14
AH_ITEM_FETCH_PER_RUN=1000

# MCP över HTTP. Sätt en lång slumpad token, t.ex. med: openssl rand -hex 32
MCP_HOST=0.0.0.0
MCP_PORT=8765
MCP_TOKEN=
