[Unit]
Description=WoW Forever AH collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=forever-ah
Group=forever-ah
EnvironmentFile=/etc/forever-ah/collector.env
ExecStart=/opt/forever-ah/venv/bin/forever-ah-collector
Restart=on-failure
RestartSec=60

# Härdning
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/forever-ah
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
